SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # Dashboard > Settings > API > service_role
OLLAMA_HOST=http://localhost:11434       # Ollamaデフォルトホスト
OLLAMA_MODEL=gemma2                     # ollama pull gemma2 で入手
CONNPASS_API_KEY=あなたのキー
# OpenWork スクレイピング用Cookie設定
# OpenWork の口コミページはログイン必須のため、ブラウザでログイン後に
# DevTools > Application > Cookies からCookie文字列をコピーして貼り付けてください。
# 未設定の場合、OpenWork スクレイパーは「データ取得不可・ログイン必須」として
# graceful degradation し、エラーでは停止しません。
OPENWORK_COOKIE=
OPENWORK_URL_MERCARI_JP=                 # 会社ページURL（例: https://www.openwork.jp/...）
OPENWORK_URL_MAP={}                      # 例: {"mercari-jp":"https://www.openwork.jp/..."}